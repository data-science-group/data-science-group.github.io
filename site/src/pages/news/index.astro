---
// News — every entry from the news collection, newest first, grouped by year.
// Entries are admin-managed (Decap "News" collection); this page just lists.
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => base.replace(/\/$/, "") + p;

const entries = (await getCollection("news")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime() || a.data.title.localeCompare(b.data.title),
);
const years = [...new Set(entries.map((e) => e.data.date.getUTCFullYear()))];
const byYear = new Map(years.map((y) => [y, entries.filter((e) => e.data.date.getUTCFullYear() === y)]));

// Dates are stored date-only (UTC midnight) — format in UTC so the shown day
// never shifts with the build machine's timezone.
const fmt = new Intl.DateTimeFormat("en-AU", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });

const KIND_LABEL: Record<string, string> = {
  "lab-news": "Lab news",
  "tech-news": "Tech news",
  "linkedin-mirror": "LinkedIn",
  event: "Event",
  award: "Award",
  publication: "Publication",
  keynote: "Keynote",
};

---
<Base
  title="News — Data Science Research Lab, Macquarie University"
  description="News from the Data Science Research Lab at Macquarie University — keynotes, events, awards and updates from the lab and its programs."
>
  <h1>News</h1>
  <p class="lede">Keynotes, events, awards and updates from the lab.</p>

  <nav class="yearbar" aria-label="Years">
    {years.map((y) => <a href={`#y${y}`}>{y} <small>({byYear.get(y).length})</small></a>)}
  </nav>

  {years.map((y) => (
    <section class="yeargroup" aria-labelledby={`y${y}`}>
      <h2 id={`y${y}`}>{y}</h2>
      <ol class="newslist">
        {byYear.get(y).map((e) => (
          <li class="news-item">
            <div class="meta">
              <time datetime={e.data.date.toISOString().slice(0, 10)}>{fmt.format(e.data.date)}</time>
              {e.data.kind && <span class={`badge badge-${e.data.kind}`}>{KIND_LABEL[e.data.kind] ?? e.data.kind}</span>}
            </div>
            <div class="title">{e.data.title}</div>
            {/* covers intentionally not rendered here — founder decision
                2026-07-06: images appear on the home strip only */}
            <p class="teaser">{e.data.teaser}</p>
            {e.data.source && (
              <div class="actions">
                <a class="chip" href={e.data.source.url}>{e.data.source.label}</a>
              </div>
            )}
          </li>
        ))}
      </ol>
    </section>
  ))}
</Base>

<style>
  .lede { font-size: 1.08rem; }
  .yearbar { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); margin: var(--space-3) 0 var(--space-4); font: var(--text-nav); }
  .yearbar a { text-decoration: none; color: var(--accent); }
  .yearbar small { color: var(--ink-2); font-weight: 400; }
  .yeargroup h2 { text-align: left; border-bottom: 3px solid var(--teal); display: inline-block; padding-bottom: 4px; }
  .newslist { list-style: none; padding: 0; margin: 0; }
  .news-item { padding: var(--space-3) 0; border-bottom: 1px solid var(--line); max-width: 100ch; }
  .meta { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); align-items: center; font: var(--text-meta); color: var(--ink-2); }
  .badge { font: var(--text-nav); font-size: .68rem; letter-spacing: .05em; text-transform: uppercase; padding: 2px 10px; border-radius: 99px; background: var(--sand); color: var(--ink); }
  .badge-keynote { background: var(--teal); color: #fff; }
  .badge-event { background: var(--slate); color: #fff; }
  .badge-award { background: var(--flag); color: #fff; }
  .badge-publication { background: var(--teal-down); color: #fff; }
  .news-item .title { margin-top: 4px; font: var(--text-subhead); font-family: var(--font-sans); font-weight: 700; font-size: 1.06rem; color: var(--ink); }
  .teaser { margin: 6px 0 0; color: var(--ink-2); max-width: var(--measure); }
  .actions { margin-top: 8px; }
  .chip { font: var(--text-nav); font-size: .72rem; letter-spacing: .04em; padding: 4px 12px; border: 1.5px solid var(--teal-down); border-radius: 99px; color: var(--teal-down); text-decoration: none; display: inline-block; }
  .chip:hover { background: var(--teal); border-color: var(--teal); color: #fff; }
</style>
